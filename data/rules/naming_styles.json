  "styles": [
    {
      "id": "old-norse",
      "race": "Human",
      "culture": "Old Norse",
      "name": "Old Norse (saga age)",
      "summary": "Two elements, then the father's name in the genitive with son or daughter. Spellings are simplified from the sagas.",
      "pattern": "{given} {father}{suffix}",
      "parts": {
        "given": {
          "kind": "elements",
          "first": ["Thor", "Arn", "As", "Gud", "Hall", "Sig", "Vig"],
          "second_male": ["bjorn", "stein", "geir", "vald", "mund"],
          "second_female": ["dis", "gerd", "hild", "laug", "run"]
        },
        "father": {
          "kind": "elements",
          "first": ["Thor", "Arn", "As", "Gud", "Hall", "Sig", "Vig"],
          "second": ["bjorn", "stein", "geir", "vald", "mund"]
        },
        "suffix": {"kind": "by_gender", "male": "sson", "female": "sdottir"}
      },
      "rewrites": {"bjornsson": "bjarnarson", "bjornsdottir": "bjarnardottir"}
    },
    {
