{
  // Pylance must run type checking for `# pyright: ignore[...]` comments to mean
  // anything; with checking off the rule never fires and the suppression is inert.
  "python.analysis.typeCheckingMode": "standard",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // mypy is the project's checker of record (CLAUDE.md: `mypy app/`). Pylance runs
  // alongside it for editor feedback only.
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  }
}
