#!/usr/bin/env python3
"""Type-check the app, then raise the patch version (0.1.4 → 0.1.5) with every commit.

**mypy first**, when the commit stages Python under ``app/``: ``mypy app/`` as configured in
pyproject.toml (strict), with its cache, so a run after a small change takes seconds. An
error stops the commit, before the version moves. It reads the working copies, not only
what is staged. Skipped with PARAVENT_NO_MYPY=1, or when mypy is not installed.

The version is set once, in pyproject.toml (app/__init__.py reads it); uv.lock records
it too. Only the version line changes, in the staged files and the working copies alike,
so nothing else unstaged slips into the commit.

The bump is skipped when the commit already changes the version itself (raising minor or
major by hand), or with PARAVENT_NO_BUMP=1.

Enable once per clone:  git config core.hooksPath scripts/hooks
"""

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

PROJECT = "pyproject.toml"
LOCK = "uv.lock"
PROJECT_LINE = re.compile(r'^(version = ")(\d+)\.(\d+)\.(\d+)(")', re.MULTILINE)
LOCK_LINE = re.compile(r'(^name = "paravent"\nversion = ")[^"]+(")', re.MULTILINE)


def git(*args: str, data: bytes | None = None) -> str:
    return subprocess.run(
        ["git", *args], input=data, capture_output=True, check=True
    ).stdout.decode()


def staged(path: str) -> str | None:
    try:
        return git("show", f":{path}")
    except subprocess.CalledProcessError:
        return None


def stage(path: str, text: str) -> None:
    """Put ``text`` into the index for ``path`` without touching anything else staged."""
    blob = git("hash-object", "-w", "--stdin", data=text.encode()).strip()
    git("update-index", "--cacheinfo", f"100644,{blob},{path}")


def type_check() -> bool:
    """mypy over the app when the commit stages Python there; False on an error."""
    if os.environ.get("PARAVENT_NO_MYPY"):
        return True
    names = git("diff", "--cached", "--name-only", "--diff-filter=ACMR").split()
    if not any(n.startswith("app/") and n.endswith(".py") for n in names):
        return True
    venv = Path(".venv/bin/mypy")
    mypy = str(venv) if venv.exists() else shutil.which("mypy")
    if mypy is None:
        print("pre-commit: mypy not installed; type check skipped", file=sys.stderr)
        return True
    done = subprocess.run([mypy, "app/"], capture_output=True, text=True)
    if done.returncode == 0:
        return True
    print(done.stdout + done.stderr, file=sys.stderr)
    print(
        "pre-commit: mypy found errors; fix them, or commit with PARAVENT_NO_MYPY=1",
        file=sys.stderr,
    )
    return False


def main() -> int:
    if not type_check():
        return 1
    if os.environ.get("PARAVENT_NO_BUMP"):
        return 0
    if re.search(r"^[+-]version = ", git("diff", "--cached", "-U0", "--", PROJECT), re.MULTILINE):
        return 0  # the commit sets the version itself
    project = staged(PROJECT)
    found = PROJECT_LINE.search(project or "")
    if project is None or found is None:
        return 0
    major, minor, patch = (int(found.group(n)) for n in (2, 3, 4))
    new = f"{major}.{minor}.{patch + 1}"

    def bump(text: str) -> str:
        return PROJECT_LINE.sub(rf"\g<1>{new}\g<5>", text, count=1)

    def bump_lock(text: str) -> str:
        return LOCK_LINE.sub(rf"\g<1>{new}\g<2>", text, count=1)

    stage(PROJECT, bump(project))
    Path(PROJECT).write_text(bump(Path(PROJECT).read_text("utf-8")), "utf-8")
    lock = staged(LOCK)
    if lock is not None and LOCK_LINE.search(lock):
        stage(LOCK, bump_lock(lock))
        Path(LOCK).write_text(bump_lock(Path(LOCK).read_text("utf-8")), "utf-8")
    print(f"version {major}.{minor}.{patch} → {new}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
