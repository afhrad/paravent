# Copy to .env and point PARAVENT_REFERENCE_DIR at your own 5eTools corpus.
# Paravent ships no 5e content; the user brings the data (TECHSTACK.md section 8).

# --- Reference: the 5eTools corpus. Read-only, never written, NOT copied into the project.
PARAVENT_REFERENCE_DIR=/path/to/your/5etools-data
# Optional: the 5eTools image folder. Default: img/ next to the corpus folder
# (data/img for the corpus in data/reference), so bestiary/MM/Goblin.webp is in it.
PARAVENT_IMAGE_DIR=/path/to/your/5etools-img

# --- Library: everything you create with Paravent. This is the directory to back up.
PARAVENT_LIBRARY_DIR=data/library

# Derived indices built from the corpus. Disposable — safe to delete, rebuilt on demand.
PARAVENT_REFERENCE_CACHE_DIR=data/reference-cache
# The parsed corpus is kept there, so a restart with nothing changed takes a second, not four.
# PARAVENT_REFERENCE_SNAPSHOT=false

# --- Backups of the library (never the corpus or the cache). Empty dir: no backups.
# Must not lie inside the library or the corpus. Zip files, readable by their owner only.
PARAVENT_BACKUP_DIR=data/backups
# Local times of day, comma-separated; empty: only `python -m app.cli backup run`.
PARAVENT_BACKUP_AT=03:00
# How many to keep; the oldest beyond this are deleted.
PARAVENT_BACKUP_KEEP=14

PARAVENT_WATCH_FILES=true
PARAVENT_STRICT_VALIDATION=false

# --- Machine-drafted translations (TRANSLATION.md §7). A Claude API key; empty disables them.
# Drafts send English corpus text to Anthropic and cost per passage.
PARAVENT_TRANSLATE_API_KEY=
PARAVENT_TRANSLATE_MODEL=claude-opus-5-5
PARAVENT_TRANSLATE_EFFORT=low

# --- The website (website/README.md, "Publishing"). Where `python website/build.py --deploy`
# sends the site over SFTP: the site's own folder, ending in /.
# PARAVENT_SITE_TARGET=user@example.org:/home/user/paravent.org/
